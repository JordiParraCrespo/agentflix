# Copy to .env and edit:  cp .env.example .env

# One folder for downloads AND library. Must be a single disk/partition so
# hardlinks work (e.g. your big USB or internal media drive).
DATA=/srv/data
# App settings and databases. Best on a fast disk (SSD).
CONFIG=/srv/config

# Run `id -u` and `id -g` on the server to get these.
PUID=1000
PGID=1000
TZ=Europe/Madrid

# Hardware transcoding for Jellyfin (Intel/AMD GPU). setup.sh tells you if
# your server has one (/dev/dri); if so, uncomment this line.
#COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# Password for the Samba network folders (user name: media). Change it!
SAMBA_PASSWORD=change-me

# Mullvad VPN (WireGuard). Torrents, indexer searches and subtitle lookups
# only run through it.
# Get both values at https://mullvad.net/account/wireguard-config: choose
# Linux, generate a key, pick a server and download the file. Copy its
# PrivateKey value and the first (IPv4) value of Address, e.g. 10.64.0.2/32.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
# Optional, comma-separated, e.g. Spain,France,Switzerland. Empty = any server.
VPN_SERVER_COUNTRIES=

# Only for another VPN provider (see "Other VPN providers" in the README).
#VPN_SERVICE_PROVIDER=protonvpn
#VPN_PORT_FORWARDING=on
