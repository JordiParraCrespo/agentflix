# Copy to .env and edit:  cp .env.example .env

# Where your films and series live (Plex reads from here).
# Inside it, the stack uses "movies/" and "series/" subfolders.
MEDIA=/mnt/disk/media
# Where app configs, Plex database and torrent downloads go.
# Put it on a real disk (not a Raspberry Pi SD card).
STORAGE=/mnt/disk/storage

# Run `id -u` and `id -g` on the server to get these.
PUID=1000
PGID=1000
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Madrid

# Optional: token from https://plex.tv/claim (expires in 4 minutes) to link
# the server to your Plex account on first start.
PLEX_CLAIM=

# Change these!
SAMBA_USER=plex
SAMBA_PASSWORD=change-me-samba
TRANSMISSION_USER=admin
TRANSMISSION_PASSWORD=change-me-transmission
